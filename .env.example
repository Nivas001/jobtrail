# Appwrite project (Console → Overview)
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key with Auth (users.*, sessions.write), Database and Storage scopes.
# Used for sign-in plumbing and scripts/setup-appwrite.mjs; never sent to the browser.
APPWRITE_API_KEY=

# Comma-separated GitHub usernames allowed to sign in (empty = anyone with GitHub)
ALLOWED_GITHUB_LOGINS=your-github-username

# Where the browser finds the local AI helper
NEXT_PUBLIC_AI_HELPER_URL=http://127.0.0.1:4777
