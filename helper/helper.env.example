# Copy to ~/.config/jobtrail/helper.env
# Sites allowed to use the helper (comma separated): local dev + your deployment
JOBTRAIL_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional: Antigravity model id (see `agy models`)
AGY_MODEL=
# Optional: port (default 4777)
# JOBTRAIL_HELPER_PORT=4777
